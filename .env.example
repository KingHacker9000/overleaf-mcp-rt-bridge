BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_MAX_JSON_BODY=32mb
MCP_BEARER_TOKEN=replace-with-a-long-random-token
OVERLEAF_CREDENTIALS_FILE=/var/lib/overleaf-mcp-rt-bridge/secrets/credentials.json
UPSTREAM_MCP_COMMAND=/var/lib/overleaf-mcp-rt-bridge/repo/node_modules/.bin/overleaf-mcp-rt

# Optional comma-separated policy controls. Empty means all upstream tools are exposed.
BRIDGE_ALLOWED_TOOLS=
BRIDGE_DENIED_TOOLS=

# Leave disabled unless you intentionally want writes to Overleaf history-OT docs.
OVERLEAF_HISTORY_OT_WRITES=0
