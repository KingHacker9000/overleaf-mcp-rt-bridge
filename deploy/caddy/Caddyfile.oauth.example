mcp.example.com {
    encode zstd gzip

    @oauth path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-authorization-server /oauth/*
    reverse_proxy @oauth 127.0.0.1:9456 {
        flush_interval -1
        transport http {
            dial_timeout 10s
            response_header_timeout 10m
        }
    }

    reverse_proxy /health 100.64.0.10:8787
}
